---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { contact } from '../data/site';
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(contact.mapsQuery)}&output=embed`;
---
<Base title="Contact | Direct Installations Manchester" description="Contact Direct Installations for VELFAC supply, installation, servicing and repairs across the North West, North Wales and beyond.">
  <PageHero eyebrow="Contact us" title="Let's talk about your project." subtitle="Call or email our specialist team for windows, doors, servicing or repairs." />
  <section class="container-content py-16 lg:py-24"><div class="grid gap-16 lg:grid-cols-5"><div class="reveal lg:col-span-2"><h2 class="text-3xl font-semibold">Contact details</h2><ul class="mt-8 divide-y divide-black/15 border-t border-black/15"><li class="py-5"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-brand-red">Phone</p><a href={contact.phoneHref} class="mt-2 inline-block text-xl font-medium text-brand-ink hover:text-brand-red">{contact.phone}</a></li><li class="py-5"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-brand-red">Supply &amp; installation</p><a href={`mailto:${contact.salesEmail}`} class="mt-2 inline-block text-sm font-medium text-brand-ink hover:text-brand-red">{contact.salesEmail}</a></li><li class="py-5"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-brand-red">Servicing &amp; repairs</p><a href={`mailto:${contact.serviceEmail}`} class="mt-2 inline-block text-sm font-medium text-brand-ink hover:text-brand-red">{contact.serviceEmail}</a></li><li class="py-5"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-brand-red">Showroom</p><address class="mt-2 not-italic text-sm leading-relaxed text-brand-ink">{contact.address.line1}<br />{contact.address.line2}, {contact.address.city}<br />{contact.address.postcode}</address></li></ul></div><div class="reveal lg:col-span-3" data-delay="1"><div class="bg-paper p-8 sm:p-12"><p class="eyebrow">Send an enquiry</p><h2 class="mt-4 text-4xl font-semibold leading-tight sm:text-5xl">Choose the right team.</h2><p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-muted">Our contact form is currently under maintenance. Email the appropriate team directly and we will get back to you.</p><div class="mt-10 divide-y divide-black/15 border-t border-black/15"><a href={`mailto:${contact.salesEmail}?subject=Supply%20%26%20Installation%20enquiry`} class="group flex items-center justify-between gap-5 py-5"><div><p class="font-medium text-brand-ink group-hover:text-brand-red">Supply &amp; installation</p><p class="mt-1 text-sm text-slate-muted">New windows, doors and installation projects</p></div><span class="text-brand-red" aria-hidden="true">→</span></a><a href={`mailto:${contact.serviceEmail}?subject=Servicing%20%26%20Repairs%20enquiry`} class="group flex items-center justify-between gap-5 py-5"><div><p class="font-medium text-brand-ink group-hover:text-brand-red">Servicing &amp; repairs</p><p class="mt-1 text-sm text-slate-muted">Repairs, refurbishment and aftercare</p></div><span class="text-brand-red" aria-hidden="true">→</span></a></div><a href={contact.phoneHref} class="btn-primary mt-8">Call {contact.phone}</a></div></div></div><div class="reveal mt-16 overflow-hidden rounded-[2rem] bg-paper" data-delay="2"><iframe title="Map showing Direct Installations, Denton, Manchester" src={mapSrc} width="100%" height="420" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div></section>
</Base>
