---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServicesInteractive from '../components/ServicesInteractive.astro';
import Coverage from '../components/Coverage.astro';
import Testimonials from '../components/Testimonials.astro';
import ProjectsGrid from '../components/ProjectsGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import { business } from '../data/site';
---
<Base>
  <Hero />
  <section class="container-content py-20 text-center lg:py-28"><div class="reveal mx-auto max-w-4xl"><p class="eyebrow justify-center">About Direct Installations</p><h2 class="mt-4 text-4xl font-semibold leading-tight text-brand-ink sm:text-5xl">Specialist knowledge. Straightforward service.</h2><p class="mt-6 text-lg leading-relaxed text-slate-muted">{business.about}</p><a href="/about" class="mt-8 inline-flex border-b border-brand-red pb-1 text-sm font-medium text-brand-ink transition hover:text-brand-red">More about us <span class="ml-2" aria-hidden="true">→</span></a></div></section>
  <ServicesInteractive />
  <Coverage />
  <section class="container-content py-20 lg:py-28"><div class="reveal mb-12 flex flex-col gap-5 border-b border-black/15 pb-8 sm:flex-row sm:items-end sm:justify-between"><div><p class="eyebrow">Recent Projects</p><h2 class="mt-4 text-4xl font-semibold sm:text-5xl">Work we're proud of.</h2><p class="mt-3 text-slate-muted">{business.distributorLine}</p></div><a href="/projects" class="btn-ghost">View all projects</a></div><ProjectsGrid limit={6} /></section>
  <Testimonials />
  <CtaBand />
</Base>
