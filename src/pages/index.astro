---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServicesInteractive from '../components/ServicesInteractive.astro';
import Coverage from '../components/Coverage.astro';
import Testimonials from '../components/Testimonials.astro';
import ProjectsGrid from '../components/ProjectsGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import { business } from '../data/site';
---
<Base>
  <Hero />

  <!-- About intro -->
  <section class="container-content py-20 lg:py-24">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="eyebrow justify-center">About Direct Installations</p>
      <p class="mt-5 text-lg leading-relaxed text-brand-ink sm:text-xl">
        {business.about}
      </p>
      <a href="/about" class="mt-8 inline-flex items-center gap-1.5 font-semibold text-brand-red">
        More about us
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </a>
    </div>
  </section>

  <ServicesInteractive />
  <Coverage />

  <!-- Recent projects -->
  <section class="container-content py-20 lg:py-28">
    <div class="reveal mb-12 flex flex-col items-end justify-between gap-4 sm:flex-row">
      <div>
        <p class="eyebrow">Recent Projects</p>
        <h2 class="mt-3 text-3xl font-extrabold text-brand-ink sm:text-4xl">Work we're proud of</h2>
        <p class="mt-3 max-w-md text-slate-muted">{business.distributorLine}</p>
      </div>
      <a href="/projects" class="btn-ghost">View all projects</a>
    </div>
    <ProjectsGrid limit={6} />
  </section>

  <Testimonials />
  <CtaBand />
</Base>
