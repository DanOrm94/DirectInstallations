---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { business, contact } from '../data/site';

const highlights = [
  { label: 'Authorised VELFAC Distributor', detail: 'Genuine VELFAC products supplied and installed.' },
  { label: 'Approved DOVISTA Service Agent', detail: 'Factory-recognised servicing and repairs.' },
  { label: '20+ years experience', detail: 'Extensive knowledge of DOVISTA products.' },
  { label: 'Denton showroom', detail: 'Visit by appointment for expert advice.' },
];
---
<Base title="About | Direct Installations" description={business.about}>
  <PageHero
    eyebrow="About us"
    title="VELFAC & Rationel specialists in Manchester"
    subtitle={business.tagline}
  />

  <section class="container-content py-16 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="reveal lg:col-span-2">
        <p class="text-lg leading-relaxed text-brand-ink">{business.about}</p>

        <div class="mt-10 grid gap-5 sm:grid-cols-2">
          {highlights.map((h, i) => (
            <div class="reveal rounded-2xl border border-black/10 bg-white p-6 shadow-card" data-delay={String((i % 2) + 1)}>
              <h3 class="flex items-center gap-2 font-bold text-brand-ink">
                <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-brand-red/10 text-brand-red">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                {h.label}
              </h3>
              <p class="mt-2 text-sm text-slate-muted">{h.detail}</p>
            </div>
          ))}
        </div>
      </div>

      <aside class="reveal" data-delay="2">
        <div class="sticky top-24 rounded-3xl border border-black/10 bg-brand-black p-7 text-white shadow-card">
          <h2 class="text-xl font-bold">Visit our showroom</h2>
          <p class="mt-3 text-sm text-white/70">By appointment — discuss your project and view selected VELFAC products.</p>
          <div class="mt-6 space-y-3 text-sm">
            <p class="not-italic text-white/80">
              {contact.address.line1}<br />
              {contact.address.line2}, {contact.address.city}<br />
              {contact.address.postcode}
            </p>
            <a href={contact.phoneHref} class="block font-semibold text-brand-red-light hover:text-white">{contact.phone}</a>
          </div>
          <a href="/contact" class="btn bg-white text-brand-red mt-6 w-full hover:bg-white/90">Book a visit</a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand />
</Base>
