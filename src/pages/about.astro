---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { business, contact } from '../data/site';
const highlights = [
  { label: 'Authorised VELFAC Distributor', detail: 'Genuine VELFAC products supplied and installed.' },
  { label: 'Approved DOVISTA Service Agent', detail: 'Factory-recognised servicing and repairs.' },
  { label: '20+ years experience', detail: 'Extensive knowledge of DOVISTA products.' },
  { label: 'Denton showroom', detail: 'Visit by appointment for expert advice.' },
];
---
<Base title="About | Direct Installations" description={business.about}>
  <PageHero eyebrow="About us" title="VELFAC and Rationel specialists in Manchester." subtitle={business.tagline} />
  <section class="container-content py-16 lg:py-24"><div class="grid gap-16 lg:grid-cols-3"><div class="reveal lg:col-span-2"><p class="max-w-3xl text-xl leading-relaxed tracking-[-0.01em] text-brand-ink">{business.about}</p><div class="mt-16 grid border-t border-black/15 sm:grid-cols-2">{highlights.map((h, i) => <div class:list={["reveal border-b border-black/15 py-7", i % 2 === 1 ? 'sm:border-l sm:pl-8' : 'sm:pr-8']} data-delay={String((i % 2) + 1)}><p class="text-sm font-semibold text-brand-ink">{h.label}</p><p class="mt-2 text-sm leading-relaxed text-slate-muted">{h.detail}</p></div>)}</div></div><aside class="reveal" data-delay="2"><div class="border-t border-black/15 pt-7"><p class="eyebrow">Showroom visits</p><h2 class="mt-4 text-3xl font-semibold">See VELFAC in person.</h2><p class="mt-4 text-sm leading-relaxed text-slate-muted">Visit by appointment to discuss your project and view selected VELFAC products.</p><p class="mt-7 text-sm leading-relaxed text-brand-ink">{contact.address.line1}<br />{contact.address.line2}, {contact.address.city}<br />{contact.address.postcode}</p><a href={contact.phoneHref} class="mt-5 inline-block border-b border-brand-red pb-1 text-sm font-medium text-brand-ink hover:text-brand-red">{contact.phone}</a><a href="/contact" class="btn-primary mt-8">Book a visit</a></div></aside></div></section>
  <CtaBand />
</Base>
