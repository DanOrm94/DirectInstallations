---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/site';
---
<Base title="Services | Direct Installations" description="VELFAC windows & doors, supply & installation, and specialist servicing & repairs across the North West, North Wales, Northern England, Wales and the Midlands.">
  <PageHero eyebrow="Our Services" title="Support for every stage of your project." subtitle="Specialist VELFAC and Rationel advice, supply, installation and aftercare." />
  <div class="container-content py-16 lg:py-24"><div class="divide-y divide-black/15">{services.map((service, i) => <section id={service.id} class="reveal grid scroll-mt-24 gap-10 py-14 first:pt-0 lg:grid-cols-2 lg:items-center lg:py-20"><div class={i % 2 === 1 ? 'lg:order-2' : ''}><div class="flex h-11 w-11 items-center justify-center rounded-full bg-paper text-brand-ink"><ServiceIcon name={service.icon} class="h-5 w-5" /></div><p class="mt-8 text-sm font-medium text-brand-red">0{i + 1}</p><h2 class="mt-3 text-4xl font-semibold leading-tight text-brand-ink sm:text-5xl">{service.title}</h2><p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-muted">{service.description}</p><ul class="mt-8 grid gap-3 border-t border-black/15 pt-6 sm:grid-cols-2">{service.points.map((point) => <li class="text-sm text-brand-ink">{point}</li>)}</ul><a href="/contact" class="btn-primary mt-9">Enquire now</a></div><div class={i % 2 === 1 ? 'lg:order-1' : ''}><div class="overflow-hidden rounded-[2rem] bg-paper p-8 sm:p-12"><svg viewBox="0 0 400 300" class="w-full" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="400" height="300" rx="12" fill="#E9EAEC" /><rect x="60" y="40" width="280" height="220" rx="3" fill="#FFF" stroke="#1D1D1F" stroke-width="5" /><rect x="74" y="54" width="252" height="192" fill="#DFEAF5" /><rect x="196" y="54" width="8" height="192" fill="#1D1D1F" /><rect x="74" y="146" width="252" height="8" fill="#1D1D1F" /><circle cx="330" cy="250" r="18" fill="#D81E27" /></svg></div></div></section>)}</div></div>
  <CtaBand />
</Base>
