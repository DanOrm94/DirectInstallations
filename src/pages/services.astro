---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import ServiceWindow from '../components/ServiceWindow.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/site';
---
<Base title="Services | Direct Installations" description="VELFAC windows & doors, supply & installation, and specialist servicing & repairs across the North West, North Wales, Northern England, Wales and the Midlands.">
  <PageHero eyebrow="Our Services" title="Support for every stage of your project." subtitle="Specialist VELFAC and Rationel advice, supply, installation and aftercare." />
  <div class="container-content py-16 lg:py-24"><div class="divide-y divide-black/15">{services.map((service, i) => <section id={service.id} class="reveal grid scroll-mt-24 gap-10 py-14 first:pt-0 lg:grid-cols-2 lg:items-center lg:py-20"><div class={i % 2 === 1 ? 'lg:order-2' : ''}><div class="flex h-11 w-11 items-center justify-center rounded-full bg-paper text-brand-ink"><ServiceIcon name={service.icon} class="h-5 w-5" /></div><h2 class="mt-8 text-4xl font-semibold leading-tight text-brand-ink sm:text-5xl">{service.title}</h2><p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-muted">{service.description}</p><ul class="mt-8 grid gap-3 border-t border-black/15 pt-6 sm:grid-cols-2">{service.points.map((point) => <li class="text-sm text-brand-ink">{point}</li>)}</ul><a href="/contact" class="btn-primary mt-9">Enquire now</a></div><div class={i % 2 === 1 ? 'lg:order-1' : ''}><ServiceWindow index={i} /></div></section>)}</div></div>
  <CtaBand />
</Base>
