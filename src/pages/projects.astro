---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProjectsGrid from '../components/ProjectsGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import { business } from '../data/site';
---
<Base title="Projects | Direct Installations" description="A selection of recent VELFAC and Rationel window and door projects across the North West and North Wales.">
  <PageHero
    eyebrow="Recent Projects"
    title="Work we're proud of"
    subtitle={business.distributorLine}
  />
  <div class="container-content py-16 lg:py-24">
    <p class="reveal mb-10 rounded-2xl border border-dashed border-brand-red/30 bg-brand-red/5 px-5 py-4 text-sm text-slate-muted">
      These are placeholder images — swap the files in <code class="rounded bg-white px-1.5 py-0.5 text-brand-red">/public/projects</code> with real project photography to go live.
    </p>
    <ProjectsGrid filterable />
  </div>
  <CtaBand />
</Base>
