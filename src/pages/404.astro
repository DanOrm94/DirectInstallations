---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Direct Installations">
  <section class="container-content flex min-h-[55vh] flex-col items-center justify-center py-24 text-center">
    <p class="text-7xl font-extrabold text-brand-red">404</p>
    <h1 class="mt-4 text-3xl font-extrabold text-brand-ink">We couldn't find that page</h1>
    <p class="mt-3 max-w-md text-slate-muted">The page may have moved or no longer exists. Let's get you back on track.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Back to home</a>
      <a href="/contact" class="btn-ghost">Contact us</a>
    </div>
  </section>
</Base>
