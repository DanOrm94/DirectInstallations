---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Direct Installations">
  <section class="container-content flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="eyebrow justify-center">Error 404</p>
    <h1 class="mt-4 text-5xl font-semibold leading-tight text-brand-ink sm:text-6xl">We couldn't find that page.</h1>
    <p class="mt-5 max-w-md text-lg leading-relaxed text-slate-muted">The page may have moved or no longer exists. Let's take you back to the start.</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3"><a href="/" class="btn-primary">Back to home</a><a href="/contact" class="btn-ghost">Contact us</a></div>
  </section>
</Base>
