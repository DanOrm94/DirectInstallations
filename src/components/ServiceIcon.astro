---
interface Props {
  name: 'window' | 'install' | 'service';
  class?: string;
}
const { name, class: className = 'h-7 w-7' } = Astro.props;
---
{name === 'window' && (
  <svg class={className} fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="4" y="3" width="16" height="18" rx="1.5" />
    <path d="M12 3v18M4 12h16" />
  </svg>
)}
{name === 'install' && (
  <svg class={className} fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M3 11.5 12 4l9 7.5" />
    <path d="M5 10v10h14V10" />
    <path d="M14.7 13.3a2.5 2.5 0 1 1-3.4 3.4l-.5.5-1.5-1.5.5-.5a2.5 2.5 0 0 1 3.4-3.4l1.3-1.3 1.5 1.5-1.3 1.3Z" />
  </svg>
)}
{name === 'service' && (
  <svg class={className} fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M14.7 6.3a4 4 0 0 1-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 1 5.4-5.4l-2.6 2.6-2-2 2.6-2.6Z" />
  </svg>
)}
