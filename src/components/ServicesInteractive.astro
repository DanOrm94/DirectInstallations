---
import ServiceIcon from './ServiceIcon.astro';
import { services } from '../data/site';
---
<section id="services" class="container-content py-20 lg:py-28">
  <div class="reveal mx-auto max-w-2xl text-center">
    <p class="eyebrow justify-center">Our Services</p>
    <h2 class="mt-4 text-4xl font-semibold leading-tight text-brand-ink sm:text-5xl">Everything for your VELFAC project.</h2>
    <p class="mt-5 text-lg text-slate-muted">From first conversation to long-term care.</p>
  </div>

  <div class="mt-16 grid border-t border-black/15 lg:grid-cols-3">
    {services.map((service, i) => (
      <article class:list={['reveal group border-b border-black/15 px-0 py-9 lg:border-b-0 lg:py-12', i > 0 ? 'lg:border-l lg:pl-8' : 'lg:pr-8']} data-delay={String(i + 1)}>
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-brand-red">0{i + 1}</span>
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-paper text-brand-ink transition group-hover:bg-brand-red group-hover:text-white">
            <ServiceIcon name={service.icon} class="h-5 w-5" />
          </div>
        </div>
        <h3 class="mt-12 text-2xl font-semibold text-brand-ink">{service.title}</h3>
        <p class="mt-3 max-w-sm leading-relaxed text-slate-muted">{service.short}</p>
        <ul class="mt-6 space-y-2 border-t border-black/10 pt-5">
          {service.points.slice(0, 3).map((point) => <li class="text-sm text-brand-ink">{point}</li>)}
        </ul>
        <a href={`/services#${service.id}`} class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-brand-ink transition hover:text-brand-red">
          Discover more <span aria-hidden="true">→</span>
        </a>
      </article>
    ))}
  </div>
</section>
