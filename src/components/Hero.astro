---
import { business } from '../data/site';
---
<section class="relative overflow-hidden bg-white">
  <div class="container-content pt-16 text-center sm:pt-20 lg:pt-24">
    <p class="eyebrow animate-fade-up justify-center">{business.tagline}</p>
    <h1 class="mx-auto mt-5 max-w-5xl animate-fade-up text-5xl font-semibold leading-[0.98] text-brand-ink sm:text-6xl lg:text-8xl" style="animation-delay:.08s">
      Windows and doors<br />
      <span class="text-brand-red">made to belong.</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl animate-fade-up text-lg leading-relaxed text-slate-muted sm:text-xl" style="animation-delay:.16s">
      {business.intro}
    </p>
    <div class="mt-8 flex animate-fade-up flex-wrap justify-center gap-3" style="animation-delay:.24s">
      <a href="/contact" class="btn-primary">Get a free quote</a>
      <a href="/services" class="btn-ghost">Explore our services</a>
    </div>
  </div>

  <!-- Product-gallery illustration: an original VELFAC window study, not product photography. -->
  <div class="container-content mt-14 animate-fade-in sm:mt-20" style="animation-delay:.28s">
    <div class="relative overflow-hidden rounded-[2rem] bg-paper px-5 pt-10 sm:px-12 sm:pt-14 lg:px-24 lg:pt-20">
      <div class="absolute left-1/2 top-7 -translate-x-1/2 text-center sm:top-10">
        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-red">VELFAC Composite</p>
        <p class="mt-1 text-xs text-slate-muted">Aluminium exterior · timber interior</p>
      </div>
      <svg viewBox="0 0 1000 540" class="mx-auto block w-full max-w-4xl" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of a four-pane VELFAC window">
        <defs>
          <linearGradient id="heroSky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#E8F2F9" />
            <stop offset="1" stop-color="#C9DCEB" />
          </linearGradient>
          <linearGradient id="heroReflection" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#FFF" stop-opacity="0.58" />
            <stop offset="1" stop-color="#FFF" stop-opacity="0" />
          </linearGradient>
        </defs>
        <rect x="75" y="80" width="850" height="410" rx="3" fill="#1D1D1F" />
        <rect x="87" y="92" width="826" height="386" fill="#FFF" />
        <rect x="102" y="107" width="796" height="356" fill="url(#heroSky)" />
        <path d="M102 390 C250 330 340 420 485 365 C630 310 745 390 898 325 V463 H102Z" fill="#B9CCBD" opacity="0.86" />
        <path d="M102 430 C270 360 350 450 505 388 C650 330 755 416 898 360 V463 H102Z" fill="#9BB09D" opacity="0.68" />
        <rect x="296" y="107" width="16" height="356" fill="#1D1D1F" />
        <rect x="492" y="107" width="16" height="356" fill="#1D1D1F" />
        <rect x="688" y="107" width="16" height="356" fill="#1D1D1F" />
        <path d="M122 112 H255 L145 453 H102 V340Z" fill="url(#heroReflection)" />
        <path d="M328 112 H435 L330 385 L312 385 V170Z" fill="url(#heroReflection)" opacity="0.7" />
        <path d="M522 112 H630 L530 370 L508 370 V162Z" fill="url(#heroReflection)" opacity="0.55" />
      </svg>
      <div class="absolute bottom-0 left-0 right-0 flex justify-between border-t border-black/10 bg-white/80 px-5 py-4 text-left backdrop-blur sm:px-8">
        <p class="text-xs text-slate-muted"><span class="font-semibold text-brand-ink">20+ years</span> with DOVISTA products</p>
        <p class="hidden text-xs text-slate-muted sm:block">Visit our Denton showroom by appointment</p>
      </div>
    </div>
  </div>

  <div class="container-content py-12 sm:py-16">
    <dl class="mx-auto grid max-w-3xl grid-cols-3 divide-x divide-black/15 text-center">
      <div class="px-3"><dt class="text-2xl font-semibold text-brand-ink sm:text-3xl">20+</dt><dd class="mt-1 text-[10px] uppercase tracking-[0.12em] text-slate-muted sm:text-xs">Years' experience</dd></div>
      <div class="px-3"><dt class="text-2xl font-semibold text-brand-ink sm:text-3xl">VELFAC</dt><dd class="mt-1 text-[10px] uppercase tracking-[0.12em] text-slate-muted sm:text-xs">Authorised distributor</dd></div>
      <div class="px-3"><dt class="text-2xl font-semibold text-brand-ink sm:text-3xl">5★</dt><dd class="mt-1 text-[10px] uppercase tracking-[0.12em] text-slate-muted sm:text-xs">Google rated</dd></div>
    </dl>
  </div>
</section>
