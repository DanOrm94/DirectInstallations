---
import Logo from './Logo.astro';
import { business, contact, nav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-brand-black text-white/80">
  <div class="container-content grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="inline-flex rounded-xl bg-white p-3">
        <Logo class="h-10 w-auto" />
      </div>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/70">
        {business.tagline}. {business.intro}
      </p>
    </div>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Explore</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="text-white/70 transition-colors hover:text-white">{item.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Contact</h3>
      <ul class="mt-4 space-y-2 text-sm text-white/70">
        <li><a href={contact.phoneHref} class="hover:text-white">{contact.phone}</a></li>
        <li><a href={`mailto:${contact.salesEmail}`} class="hover:text-white">{contact.salesEmail}</a></li>
        <li><a href={`mailto:${contact.serviceEmail}`} class="hover:text-white">{contact.serviceEmail}</a></li>
        <li class="pt-2 not-italic">
          {contact.address.line1}<br />
          {contact.address.line2}, {contact.address.city}<br />
          {contact.address.postcode}
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-content flex flex-col items-center justify-between gap-3 py-5 text-xs text-white/55 sm:flex-row">
      <p>&copy; {year} {business.name}. All rights reserved.</p>
      <p>{business.distributorLine}</p>
    </div>
  </div>
</footer>
