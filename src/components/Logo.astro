---
// Direct Installations logo (supplied raster artwork).
interface Props {
  class?: string;
  mono?: boolean; // accepted for backwards compatibility; not used for the raster logo
}
const { class: className = '' } = Astro.props;
---
<img
  src="/logo.jpg"
  alt="Direct Installations"
  width="300"
  height="133"
  class:list={['h-auto w-auto', className]}
/>
