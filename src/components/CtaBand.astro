---
import { contact } from '../data/site';
---
<section class="bg-brand-black text-white">
  <div class="container-content py-20 text-center sm:py-24">
    <p class="eyebrow justify-center text-brand-red-light">Direct Installations</p>
    <h2 class="mx-auto mt-4 max-w-3xl text-4xl font-semibold leading-tight sm:text-5xl">Ready to start your project?</h2>
    <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/65">Speak to our team about supply, installation, servicing or repairs, or arrange a showroom visit in Denton.</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href={contact.phoneHref} class="btn bg-white text-brand-black hover:scale-[1.02] hover:bg-white/90">Call {contact.phone}</a>
      <a href="/contact" class="btn border border-white/40 text-white hover:border-white hover:bg-white/10">Send an enquiry</a>
    </div>
  </div>
</section>
