---
import Logo from './Logo.astro';
import { nav, contact } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-black/5 bg-white/85 backdrop-blur-md transition-shadow"
>
  <div class="container-content flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center" aria-label="Direct Installations home">
      <Logo class="h-11 w-auto" />
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'link-underline text-sm font-semibold transition-colors',
            isActive(item.href) ? 'text-brand-red' : 'text-brand-ink hover:text-brand-red',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={contact.phoneHref} class="text-sm font-semibold text-brand-ink hover:text-brand-red">
        {contact.phone}
      </a>
      <a href="/contact" class="btn-primary">Get a quote</a>
    </div>

    <button
      id="menu-toggle"
      class="inline-flex items-center justify-center rounded-lg p-2 text-brand-ink md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-black/5 bg-white md:hidden">
    <nav class="container-content flex flex-col py-3" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-lg px-2 py-3 text-base font-semibold',
            isActive(item.href) ? 'text-brand-red' : 'text-brand-ink',
          ]}
        >
          {item.label}
        </a>
      ))}
      <div class="mt-2 flex flex-col gap-2">
        <a href={contact.phoneHref} class="btn-ghost">Call {contact.phone}</a>
        <a href="/contact" class="btn-primary">Get a quote</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('site-header');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  // Add a subtle shadow once the page scrolls.
  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('shadow-md', window.scrollY > 8);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
