---
import { projects } from '../data/site';
interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const list = limit ? projects.slice(0, limit) : projects;
---
<div class="space-y-16 lg:space-y-24">
  {list.map((project, i) => (
    <article class="reveal" data-delay={String((i % 3) + 1)}>
      <header class="max-w-3xl">
        <h2 class="text-3xl font-semibold leading-tight text-brand-ink sm:text-4xl">{project.title}</h2>
        <p class="mt-3 text-lg leading-relaxed text-slate-muted">{project.description}</p>
        {project.client && (
          <p class="mt-4 text-sm text-slate-muted">
            <span class="font-medium text-brand-ink">Client:</span> {project.client}
          </p>
        )}
      </header>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {project.images.map((img) => (
          <figure class="group overflow-hidden rounded-2xl bg-paper">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                decoding="async"
                width="2560"
                height="1440"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
          </figure>
        ))}
      </div>
    </article>
  ))}
</div>
